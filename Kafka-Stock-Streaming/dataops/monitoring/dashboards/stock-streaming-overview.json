{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": true,
  "panels": [
    {
      "title": "Producer Messages/sec",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "stock_producer_messages_per_second",
          "legendFormat": "msgs/sec"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "msg/s", "color": { "mode": "thresholds" }, "thresholds": { "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 500}, {"color": "red", "value": 100}] } }
      }
    },
    {
      "title": "Consumer Batch Write Latency",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(stock_consumer_batch_write_seconds_bucket[1m]))",
          "legendFormat": "p95 write"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s", "color": { "mode": "thresholds" }, "thresholds": { "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 0.5}, {"color": "red", "value": 2}] } }
      }
    },
    {
      "title": "Active Symbols",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "stock_producer_symbols_count",
          "legendFormat": "symbols"
        }
      ]
    },
    {
      "title": "Services Health",
      "type": "stat",
      "gridPos": { "h": 4, "w": 8, "x": 16, "y": 0 },
      "targets": [
        { "expr": "stock_producer_active", "legendFormat": "Producer" },
        { "expr": "stock_consumer_active", "legendFormat": "Consumer" }
      ]
    },
    {
      "title": "Production Rate Over Time",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [
        {
          "expr": "rate(stock_producer_messages_total{status=\"success\"}[1m])",
          "legendFormat": "{{symbol}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "msg/s" } }
    },
    {
      "title": "Consumer Processing Latency (p50, p95, p99)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [
        { "expr": "histogram_quantile(0.50, rate(stock_consumer_processing_latency_seconds_bucket[1m]))", "legendFormat": "p50" },
        { "expr": "histogram_quantile(0.95, rate(stock_consumer_processing_latency_seconds_bucket[1m]))", "legendFormat": "p95" },
        { "expr": "histogram_quantile(0.99, rate(stock_consumer_processing_latency_seconds_bucket[1m]))", "legendFormat": "p99" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "title": "Stock Prices (Last Values)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 12 },
      "targets": [
        {
          "expr": "stock_producer_last_price",
          "legendFormat": "{{symbol}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "currencyUSD" } }
    },
    {
      "title": "Kafka Consumer Lag",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 20 },
      "targets": [
        {
          "expr": "kafka_consumergroup_lag",
          "legendFormat": "partition {{partition}}"
        }
      ]
    },
    {
      "title": "DB Insert Rate",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 20 },
      "targets": [
        {
          "expr": "rate(stock_consumer_db_inserts_total{status=\"success\"}[1m])",
          "legendFormat": "inserts/sec"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "rows/s" } }
    }
  ],
  "refresh": "5s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["stock", "streaming", "kafka"],
  "templating": { "list": [] },
  "time": { "from": "now-15m", "to": "now" },
  "title": "Stock Streaming Pipeline Overview",
  "uid": "stock-streaming-overview"
}
