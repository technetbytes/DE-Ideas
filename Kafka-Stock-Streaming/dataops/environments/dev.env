# Development Environment Configuration
# Low volume, verbose logging, relaxed SLAs

# Producer
PRODUCE_INTERVAL_MS=10
LOG_LEVEL=DEBUG
METRICS_PORT=8000

# Consumer
BATCH_SIZE=100
BATCH_TIMEOUT_MS=2000
KAFKA_GROUP_ID=stock-consumer-dev

# Database
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=stockdata
POSTGRES_USER=stockuser
POSTGRES_PASSWORD=stockpass123

# SLA (relaxed for dev)
SLA_FRESHNESS_MAX_S=60
SLA_THROUGHPUT_MIN=50
SLA_LATENCY_P99_MS=1000

# Data Quality
SCAN_INTERVAL=600
DATA_RETENTION_DAYS=1

# Kafka
KAFKA_BOOTSTRAP_SERVERS=kafka:29092
KAFKA_TOPIC=stock-ticks-dev
KAFKA_NUM_PARTITIONS=3
