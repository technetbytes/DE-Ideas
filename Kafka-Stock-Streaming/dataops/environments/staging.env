# Staging Environment Configuration
# Production-like volume with synthetic data, strict SLAs

# Producer
PRODUCE_INTERVAL_MS=1
LOG_LEVEL=INFO
METRICS_PORT=8000

# Consumer
BATCH_SIZE=500
BATCH_TIMEOUT_MS=1000
KAFKA_GROUP_ID=stock-consumer-staging

# Database
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=stockdata
POSTGRES_USER=stockuser
POSTGRES_PASSWORD=${STAGING_DB_PASSWORD}

# SLA (production-equivalent)
SLA_FRESHNESS_MAX_S=30
SLA_THROUGHPUT_MIN=500
SLA_LATENCY_P99_MS=100

# Data Quality
SCAN_INTERVAL=300
DATA_RETENTION_DAYS=3

# Kafka
KAFKA_BOOTSTRAP_SERVERS=kafka:29092
KAFKA_TOPIC=stock-ticks-staging
KAFKA_NUM_PARTITIONS=6
