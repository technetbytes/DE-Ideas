# Production Environment Configuration
# Full volume, strict SLAs, alerting enabled

# Producer
PRODUCE_INTERVAL_MS=1
LOG_LEVEL=WARNING
METRICS_PORT=8000

# Consumer
BATCH_SIZE=500
BATCH_TIMEOUT_MS=1000
KAFKA_GROUP_ID=stock-consumer-prod

# Database
POSTGRES_HOST=${PROD_DB_HOST}
POSTGRES_PORT=5432
POSTGRES_DB=stockdata
POSTGRES_USER=${PROD_DB_USER}
POSTGRES_PASSWORD=${PROD_DB_PASSWORD}

# SLA (strict)
SLA_FRESHNESS_MAX_S=5
SLA_THROUGHPUT_MIN=1000
SLA_LATENCY_P99_MS=100

# Data Quality
SCAN_INTERVAL=60
DATA_RETENTION_DAYS=7

# Kafka
KAFKA_BOOTSTRAP_SERVERS=${PROD_KAFKA_BOOTSTRAP}
KAFKA_TOPIC=stock-ticks
KAFKA_NUM_PARTITIONS=12

# Alerting
SLACK_WEBHOOK_URL=${SLACK_WEBHOOK_URL}
PAGERDUTY_SERVICE_KEY=${PAGERDUTY_SERVICE_KEY}
ALERT_EMAIL=data-eng@company.com
